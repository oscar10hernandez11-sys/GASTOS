# Variables de entorno requeridas para Vite + Netlify
# Copia este archivo a .env para desarrollo local (nunca subas .env a GitHub)
# En Netlify, configura estas variables en: Site configuration -> Environment variables

VITE_SUPABASE_URL=tu_url_de_supabase
VITE_SUPABASE_ANON_KEY=tu_anon_key_de_supabase
VITE_ADMIN_EMAIL=correo_del_administrador
